  "segments": [
    {
      "kind": "thai",
      "text": "คำนมัสการพระรัตนตรัย"
    },
    {
      "kind": "pali",
      "text": "โย โส ภะคะวา อะระหัง สัมมาสัมพุทโธ"
    },
    {
      "kind": "pali",
      "text": "สวากขาโต เยนะ ภะคะวะตา ธัมโม"
    },
    {
      "kind": "pali",
      "text": "สุปะฏิปันโน ยัสสะ ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "ตัมมะยัง ภะคะวันตัง สะธัมมัง สะสังฆัง"
    },
    {
      "kind": "pali",
      "text": "อิเมหิ สักกาเรหิ ยะถาระหัง อาโรปิเตหิ อะภิปูชะยามะ"
    },
    {
      "kind": "pali",
      "text": "สาธุ โน ภันเต ภะคะวา สุจิระปะรินิพพุโตปิ"
    },
    {
      "kind": "pali",
      "text": "ปัจฉิมาชะนะตานุกัมปะมานะสา"
    },
    {
      "kind": "pali",
      "text": "อิเม สักกาเร ทุคคะตะปัณณาการะภูเต ปะฏิคคัณหาตุ"
    },
    {
      "kind": "pali",
      "text": "อัมหากัง ทีฆะรัตตัง หิตายะ สุขายะ"
    },
    {
      "kind": "pali",
      "text": "อะระหัง สัมมาสัมพุทโธ ภะคะวา"
    },
    {
      "kind": "pali",
      "text": "พุทธัง ภะคะวันตัง อะภิวาเทมิ"
    },
    {
      "kind": "cue",
      "text": "(กราบ)"
    },
    {
      "kind": "pali",
      "text": "สวากขาโต ภะคะวะตา ธัมโม"
    },
    {
      "kind": "pali",
      "text": "ธัมมัง นะมัสสามิ"
    },
    {
      "kind": "cue",
      "text": "(กราบ)"
    },
    {
      "kind": "pali",
      "text": "สุปะฏิปันโน ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "สังฆัง นะมามิ"
    },
    {
      "kind": "cue",
      "text": "(กราบ)"
    }
  ]
}
