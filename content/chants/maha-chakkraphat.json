  "segments": [
    {
      "kind": "thai",
      "text": "คาถามหาจักรพรรดิ"
    },
    {
      "kind": "pali",
      "text": "นะโมพุทธายะ พระพุทธะ ไตรรัตนะญาณ"
    },
    {
      "kind": "pali",
      "text": "มณีนพรัตน์ สีสะหัสสะ สุธรรมา"
    },
    {
      "kind": "pali",
      "text": "พุทโธ ธัมโม สังโฆ"
    },
    {
      "kind": "pali",
      "text": "ยะธาพุทโมนะ พุทธะบูชา ธัมมะบูชา สังฆะบูชา"
    },
    {
      "kind": "pali",
      "text": "อัคคีทานัง วะรังคันธัง"
    },
    {
      "kind": "pali",
      "text": "สีวะลี จะ มะหาเถรัง"
    },
    {
      "kind": "pali",
      "text": "อะหัง วันทามิ ทูระโต"
    },
    {
      "kind": "pali",
      "text": "อะหัง วันทามิ ธาตุโย"
    },
    {
      "kind": "pali",
      "text": "อะหัง วันทามิ สัพพะโส"
    },
    {
      "kind": "pali",
      "text": "พุทธะ ธัมมะ สังฆะ ปูเชมิ"
    },
    {
      "kind": "pali",
      "text": "สัพเพ พุทธา สัพเพ ธัมมา สัพเพ สังฆา"
    },
    {
      "kind": "pali",
      "text": "พะลัปปัตตา ปัจเจกานัญจะ ยัง พะลัง"
    },
    {
      "kind": "pali",
      "text": "อะระหันตานัญจะ เตเชนะ"
    },
    {
      "kind": "pali",
      "text": "รักขัง พันธามิ สัพพะโส"
    },
    {
      "kind": "pali",
      "text": "พุทธัง อะธิฏฐามิ"
    },
    {
      "kind": "pali",
      "text": "ธัมมัง อะธิฏฐามิ"
    },
    {
      "kind": "pali",
      "text": "สังฆัง อะธิฏฐามิ"
    }
