  "segments": [
    {
      "kind": "thai",
      "text": "คำอาราธนาพระเครื่อง"
    },
    {
      "kind": "pali",
      "text": "อิติปิ โส ภะคะวา"
    },
    {
      "kind": "pali",
      "text": "อะระหัง สัมมาสัมพุทโธ"
    },
    {
      "kind": "pali",
      "text": "วิชชาจะระณะสัมปันโน"
    },
    {
      "kind": "pali",
      "text": "สุคะโต โลกะวิทู"
    },
    {
      "kind": "pali",
      "text": "อะนุตตะโร ปุริสะทัมมะสาระถิ"
    },
    {
      "kind": "pali",
      "text": "สัตถา เทวะมะนุสสานัง"
    },
    {
      "kind": "pali",
      "text": "พุทโธ ภะคะวาติ"
    },
    {
      "kind": "pali",
      "text": "สวากขาโต ภะคะวะตา ธัมโม"
    },
    {
      "kind": "pali",
      "text": "สันทิฏฐิโก อะกาลิโก"
    },
    {
      "kind": "pali",
      "text": "เอหิปัสสิโก โอปะนะยิโก"
    },
    {
      "kind": "pali",
      "text": "ปัจจัตตัง เวทิตัพโพ วิญญูหีติ"
    },
    {
      "kind": "pali",
      "text": "สุปะฏิปันโน ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "อุชุปะฏิปันโน ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "ญายะปะฏิปันโน ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "สามีจิปะฏิปันโน ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "ยะทิทัง จัตตาริ ปุริสะยุคานิ"
    },
    {
      "kind": "pali",
      "text": "อัฏฐะ ปุริสะปุคคะลา"
    },
    {
      "kind": "pali",
      "text": "เอสะ ภะคะวะโต สาวะกะสังโฆ"
    },
    {
      "kind": "pali",
      "text": "อาหุเนยโย ปาหุเนยโย"
    },
    {
      "kind": "pali",
      "text": "ทักขิเณยโย อัญชะลีกะระณีโย"
    },
    {
      "kind": "pali",
      "text": "อะนุตตะรัง ปุญญักเขตตัง โลกัสสาติ"
    },
    {
      "kind": "pali",
      "text": "อิทธิฤทธิ พุทธะนิมิตตัง"
    },
    {
      "kind": "pali",
      "text": "ขอเดชะเดชัง ขอเดชเดชะ"
    },
    {
      "kind": "pali",
      "text": "จงมาเป็นที่พึ่งของข้าพเจ้า"
    },
    {
      "kind": "pali",
      "text": "มะอะอุ ณ กาลบัดนี้เถิด"
    },
    {
      "kind": "cue",
      "text": "(กลืนน้ำลาย 3 ครั้ง)"
    }
  ],
