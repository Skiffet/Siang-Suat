{
  "slug": "chinabanchon",
  "title": "คาถาชินบัญชร",
  "subtitle": "ชะยาสะนาคะตา พุทธา",
  "description": "บทอัญเชิญพระพุทธเจ้าและพระอรหันต์มาสถิตรอบกาย เพื่อเป็นเกราะคุ้มครอง",
  "tags": [
    "คาถา",
    "คุ้มครอง"
  ],
  "cover": "forest-monk",
  "category": "protection",
  "segments": [
    {
      "kind": "thai",
      "text": "คาถาชินบัญชร"
    },
    {
      "kind": "pali",
      "text": "ปุตตะกาโม ละเภ ปุตตัง"
    },
    {
      "kind": "pali",
      "text": "ธะนะกาโม ละเภ ธะนัง"
    },
    {
      "kind": "pali",
      "text": "อัตถิ กาเย กายะญายะ"
    },
    {
      "kind": "pali",
      "text": "เทวานัง ปิยะตัง สุตวา"
    },
    {
      "kind": "pali",
      "text": "อิติปิ โส ภะคะวา"
    },
    {
      "kind": "pali",
      "text": "ยะมะราชาโน ท้าวเวสสุวัณโณ"
    },
    {
      "kind": "pali",
      "text": "มะระณัง สุขัง อะระหัง สุคะโต นะโมพุทธายะ"
    },
    {
      "kind": "pali",
      "text": "ชะยาสะนาคะตา พุทธา"
    },
    {
      "kind": "pali",
      "text": "เชตะวา มารัง สะวาหะนัง"
    },
    {
      "kind": "pali",
      "text": "จะตุสัจจาสะภัง ระสัง"
    },
    {
      "kind": "pali",
      "text": "เยปิวิงสุ นราสะภา"
    },
    {
      "kind": "pali",
      "text": "ตัณหังกะราทะโย พุทธา"
    },
    {
      "kind": "pali",
      "text": "อัฏฐะวีสะติ นายะกา"
    },
    {
      "kind": "pali",
      "text": "สัพเพ ปะติฏฐิตา มัยหัง"
    },
    {
      "kind": "pali",
      "text": "มัตถะเก เต มุนิสสะรา"
    },
    {
      "kind": "pali",
      "text": "สีเส ปะติฏฐิโต มัยหัง พุทโธ"
    },
    {
      "kind": "pali",
      "text": "ธัมโม ทวิโลจะเน"
    },
    {
      "kind": "pali",
      "text": "สังโฆ ปะติฏฐิโต มัยหัง"
    },
    {
      "kind": "pali",
      "text": "อุเรสัพพะคุณากะโร"
    },
    {
      "kind": "pali",
      "text": "หะทะเย เม อะนุรุทโธ"
    },
    {
      "kind": "pali",
      "text": "สารีปุตโต จะ ทักขิเณ"
    },
    {
      "kind": "pali",
      "text": "โกณฑัญโญ ปิฏฐิภาคัสมิง"
    },
    {
      "kind": "pali",
      "text": "โมคคัลลาโน จะ วามะเก"
    },
    {
      "kind": "pali",
      "text": "ทักขิเณ สะวะเน มัยหัง"
    },
    {
      "kind": "pali",
      "text": "อาสุง อานันทะราหุโล"
    },
    {
      "kind": "pali",
      "text": "กัสสะโป จะ มะหานาโม"
    },
    {
      "kind": "pali",
      "text": "อุภาสุง วามะโสตักเก"
    },
    {
      "kind": "pali",
      "text": "เกสันเต ปิฏฐิภาคัสมิง"
    },
    {
      "kind": "pali",
      "text": "สุริโย วะ ปะภังกะโร"
    },
    {
      "kind": "pali",
      "text": "นิสินโน สิริสัมปันโน"
    },
    {
      "kind": "pali",
      "text": "โสภิโต มุนิปุงคะโว"
    },
    {
      "kind": "pali",
      "text": "กุมาระกัสสะโป เถโร"
    },
    {
      "kind": "pali",
      "text": "มะเหสี จิตตะวาทะโก"
    },
    {
      "kind": "pali",
      "text": "โส มัยหัง วะทะเน นิจจัง"
    },
    {
      "kind": "pali",
      "text": "ปะติฏฐาสิ คุณากะโร"
    },
    {
      "kind": "pali",
      "text": "ปุณโณ อังคุลิมาโล จะ"
    },
    {
      "kind": "pali",
      "text": "อุปาลี นันทะสีวะลี"
    },
    {
      "kind": "pali",
      "text": "เถรา ปัญจะ อิเม ชาตา"
    },
    {
      "kind": "pali",
      "text": "นะลาเต ติละกา มะมะ"
    },
    {
      "kind": "pali",
      "text": "เสสาสีติ มะหาเถรา"
    },
    {
      "kind": "pali",
      "text": "วิชิตา ชินะสาวะกา"
    },
    {
      "kind": "pali",
      "text": "เอเตสีติ มะหาเถรา"
    },
    {
      "kind": "pali",
      "text": "ชิตะวันโต ชิโนระสา"
    },
    {
      "kind": "pali",
      "text": "ชะลันตา สีละเตเชนะ"
    },
    {
      "kind": "pali",
      "text": "อังคะมังเคสุ สัณฐิตา"
    },
    {
      "kind": "pali",
      "text": "ระตะนัง ปุระโต อาสิ"
    },
    {
      "kind": "pali",
      "text": "ทักขิเณ เมตตะสุตตะกัง"
    },
    {
      "kind": "pali",
      "text": "ธะชัคคัง ปัจฉะโต อาสิ"
    },
    {
      "kind": "pali",
      "text": "วาเม อังคุลิมาละกัง"
    },
    {
      "kind": "pali",
      "text": "ขันธะโมระปะริตตัญจะ"
    },
    {
      "kind": "pali",
      "text": "อาฏานาฏิยะสุตตะกัง"
    },
    {
      "kind": "pali",
      "text": "อากาเส ฉะทะนัง อาสิ"
    },
    {
      "kind": "pali",
      "text": "เสษา ปาการะสัณฐิตา"
    },
    {
      "kind": "pali",
      "text": "ชินานานาวะระสังยุตตา"
    },
    {
      "kind": "pali",
      "text": "สัตตะปาการะลังกะตา"
    },
    {
      "kind": "pali",
      "text": "วาตะปิตตาทิสัญชาตา"
    },
    {
      "kind": "pali",
      "text": "พาหิรัชฌัตตุปัททะวา"
    },
    {
      "kind": "pali",
      "text": "อะเสษา วินะยัง ยันตุ"
    },
    {
      "kind": "pali",
      "text": "อะนันตะชินะเตชะสา"
    },
    {
      "kind": "pali",
      "text": "วะสะโต เม สะกิจเจนะ"
    },
    {
      "kind": "pali",
      "text": "สะทา สัมพุทธะปัญชะเร"
    },
    {
      "kind": "pali",
      "text": "ชินะปัญชะระมัชฌิมหิ"
    },
    {
      "kind": "pali",
      "text": "วิหะรันตัง มะฮีตะเล"
    },
    {
      "kind": "pali",
      "text": "สะทา ปาเลนตุ มัง สัพเพ"
    },
    {
      "kind": "pali",
      "text": "เต มะหาปุริสาสะภา"
    },
    {
      "kind": "pali",
      "text": "อิจเจวะมันโต สุคุตโต สุรักโข"
    },
    {
      "kind": "pali",
      "text": "ชินานุภาเวนะ ชิตุปัททะโว"
    },
    {
      "kind": "pali",
      "text": "ธัมมานุภาเวนะ ชิตาริสังโฆ"
    },
    {
      "kind": "pali",
      "text": "สังฆานุภาเวนะ ชิตันตะราโย"
    },
    {
      "kind": "pali",
      "text": "สัทธัมมานุภาวะปาลิโต"
    },
    {
      "kind": "pali",
      "text": "จะรามิ ชินะปัญชะเรติ"
    }
  ],
