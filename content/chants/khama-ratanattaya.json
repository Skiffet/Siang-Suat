  "segments": [
    {
      "kind": "thai",
      "text": "บทขอขมาพระรัตนตรัย"
    },
    {
      "kind": "pali",
      "text": "สัพพัง อะปะราธัง ขะมะถะ เม ภันเต"
    },
    {
      "kind": "pali",
      "text": "อุกาสะ ทะวารัตตะเยนะ กะตัง"
    },
    {
      "kind": "pali",
      "text": "สัพพัง อะปะราธัง ขะมะถะ เม ภันเต"
    },
    {
      "kind": "pali",
      "text": "อุกาสะ ขะมามิ ภันเต"
    },
    {
      "kind": "thai",
      "text": "หากข้าพระพุทธเจ้า ได้เคยประมาทพลาดพลั้งล่วงเกิน ต่อพระรัตนตรัย"
    },
    {
      "kind": "thai",
      "text": "อันมีพระพุทธเจ้า ทุกๆ พระองค์"
    },
    {
      "kind": "thai",
      "text": "พระปัจเจกพุทธเจ้า ทุกๆ พระองค์"
    },
    {
      "kind": "thai",
      "text": "พระธรรม และพระอริยสงฆ์ทั้งหลาย"
    },
    {
      "kind": "thai",
      "text": "ในชาติก่อนก็ดี ชาตินี้ก็ดี"
    },
    {
      "kind": "thai",
      "text": "ด้วยทางกายหรือวาจาก็ดี และด้วยเจตนาหรือไม่มีเจตนาก็ดี"
    },
    {
      "kind": "thai",
      "text": "รู้เท่าไม่ถึงการณ์ก็ดี"
    },
    {
      "kind": "thai",
      "text": "ขอองค์สมเด็จพระสัมมาสัมพุทธเจ้า ทุกๆ พระองค์"
    },
    {
      "kind": "thai",
      "text": "พระปัจเจกพุทธเจ้า ทุกๆ พระองค์"
    },
    {
      "kind": "thai",
      "text": "พระธรรม พระอริยสงฆ์ทั้งหลาย และผู้มีพระคุณทุกท่าน"
    },
    {
      "kind": "thai",
      "text": "ได้โปรดอดโทษให้แก่ข้าพระพุทธเจ้า ตั้งแต่บัดนี้เป็นต้นไป"
    },
    {
      "kind": "thai",
      "text": "ตราบเท่าเข้าสู่พระนิพพาน ด้วยเทอญ"
    }
  ]
}
