# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template belongs in the repo, so people know what keys to set
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source assets, not what the site serves.
# `public/covers` and `public/audio` are the derived files the build ships;
# these are the originals they came from — full-resolution art and unencoded
# WAV takes, tens of megabytes that git would keep forever. Back them up
# somewhere else (Drive, R2); they are only needed to re-derive the assets.
/images/

# Voice-comparison samples from `npm run tts:try`. Regenerable, and /test
# degrades to an empty state without them.
/public/audio/test/
