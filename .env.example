# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์จริง
# .env.local ถูก gitignore ไว้แล้ว จะไม่หลุดขึ้น git

# Gemini — ขอฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud TTS — ชี้ไปที่ไฟล์ service account JSON (ถ้าจะใช้)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Edge TTS ไม่ต้องใส่อะไร ใช้ได้เลย
